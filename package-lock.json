{
  "name": "recalltrace-ai",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "recalltrace-ai",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
      }
    },
    "apps/api": {
      "name": "@recalltrace/api",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/web": {
      "name": "@recalltrace/web",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "node_modules/@recalltrace/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@recalltrace/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}

{
  "name": "@recalltrace/api",
  "version": "0.1.0",
  "private": true,
  "description": "RecallTrace Node.js and Express API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 src/memory/claimExtractor.test.ts src/hydradb/claimRepository.integration.test.ts src/app.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "milestone:1": "tsx src/scripts/runMilestoneOne.ts",
    "milestone:1:verify": "tsx src/scripts/verifyMilestoneOnePersistence.ts"
  },
  "dependencies": {
    "@recalltrace/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
